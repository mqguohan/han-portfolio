{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),path=require('path'),root='D:/claude/datanteater3.0';const mime={'.html':'text/html','.css':'text/css','.js':'text/javascript','.png':'image/png','.jpg':'image/jpeg','.svg':'image/svg+xml','.ico':'image/x-icon'};http.createServer((req,res)=>{const fp=path.join(root,req.url==='/'?'index.html':req.url);try{const data=fs.readFileSync(fp);res.writeHead(200,{'Content-Type':mime[path.extname(fp)]||'text/plain'});res.end(data);}catch{res.writeHead(404);res.end('Not found');}}).listen(3131,()=>console.log('Datanteater serving on http://localhost:3131'));"
      ],
      "port": 3131
    }
  ]
}
